{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JapaneseRapResearchBank",
  "type": "object",
  "required": ["schema", "theme", "scene_refs", "keywords"],
  "properties": {
    "schema": {"const": "research-bank/v1"},
    "theme": {"type": "string", "minLength": 1},
    "concept": {"type": ["string", "null"]},
    "scene_refs": {"type": "array", "items": {"type": "string"}},
    "scout_seed_motifs": {"type": "array", "items": {"type": "string"}},
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "surface", "reading", "mora_count", "vowel_skeleton",
          "consonant_skeleton", "kind", "domain", "plain_meaning",
          "evidence", "confidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^K[0-9]{2,4}$"},
          "surface": {"type": "string", "minLength": 1},
          "reading": {"type": "string", "minLength": 1},
          "mora_count": {"type": "integer", "minimum": 1},
          "vowel_skeleton": {"type": "string", "minLength": 1},
          "consonant_skeleton": {"type": "string", "minLength": 1},
          "kind": {"enum": ["vocabulary", "episode", "association"]},
          "domain": {
            "enum": [
              "object", "action", "place", "time_or_number", "sound",
              "body", "institution_or_money", "relationship", "other"
            ]
          },
          "plain_meaning": {"type": "string", "minLength": 1},
          "usage_note": {"type": ["string", "null"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "pointer"],
              "properties": {
                "kind": {
                  "enum": [
                    "user_input", "performed_reading", "dictionary",
                    "interview", "paper", "inference", "web"
                  ]
                },
                "pointer": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "additionalProperties": true
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
