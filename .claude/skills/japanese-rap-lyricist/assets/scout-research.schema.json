{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JapaneseRapScoutResearch",
  "type": "object",
  "required": ["schema", "round", "focus", "angles"],
  "properties": {
    "schema": {"const": "scout-research/v1"},
    "round": {"type": "integer", "minimum": 1},
    "focus": {"type": "string", "minLength": 1},
    "angles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["premise", "motifs", "evidence"],
        "properties": {
          "premise": {"type": "string", "minLength": 1},
          "motifs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "pointer"],
              "properties": {
                "kind": {
                  "enum": [
                    "user_input", "performed_reading", "dictionary",
                    "interview", "paper", "inference", "web"
                  ]
                },
                "pointer": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
