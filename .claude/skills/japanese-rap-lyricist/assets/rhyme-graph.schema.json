{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JapaneseRapRhymeGraph",
  "type": "object",
  "required": ["nodes", "spans", "occurrences", "families", "edges", "limitations"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "surface", "reading", "vowel_sequence", "consonant_sequence",
          "mora_count", "accent", "part_of_speech", "register",
          "semantic_domains", "frequency", "freshness", "cliche_risk",
          "articulation_cost", "proper_noun", "particle_affordances",
          "particles_before", "particles_after",
          "bar", "position", "source", "reading_confidence"
        ],
        "properties": {
          "id": {"type": "string"},
          "surface": {"type": "string"},
          "reading": {"type": "string"},
          "vowel_sequence": {"type": "array", "items": {"type": "string"}},
          "consonant_sequence": {"type": "array", "items": {"type": ["string", "null"]}},
          "mora_count": {"type": "integer", "minimum": 1},
          "accent": {"type": ["string", "null"]},
          "part_of_speech": {"type": ["string", "null"]},
          "register": {"type": ["string", "null"]},
          "semantic_domains": {"type": "array", "items": {"type": "string"}},
          "frequency": {"type": ["number", "null"], "minimum": 0},
          "freshness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "cliche_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "articulation_cost": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "proper_noun": {"type": "boolean"},
          "particle_affordances": {"type": "array", "items": {"type": "string"}},
          "particles_before": {"type": "array", "items": {"type": "string"}},
          "particles_after": {"type": "array", "items": {"type": "string"}},
          "bar": {"type": ["integer", "null"], "minimum": 1},
          "position": {"enum": ["initial", "internal", "caesura", "end", "cross_bar", "unplaced"]},
          "source": {"type": "string"},
          "reading_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "node_id", "performed_reading", "mora_count", "token_boundary_signature"],
        "properties": {
          "id": {"type": "string"},
          "node_id": {"type": "string"},
          "performed_reading": {"type": "string"},
          "mora_count": {"type": "integer", "minimum": 1},
          "token_boundary_signature": {"type": "array", "items": {"type": "integer"}}
        },
        "additionalProperties": false
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "span_id", "bar", "position", "audio_verified"],
        "properties": {
          "id": {"type": "string"},
          "span_id": {"type": "string"},
          "bar": {"type": ["integer", "null"]},
          "position": {"type": "string"},
          "audio_verified": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "member_node_ids", "prototype_vowels"],
        "properties": {
          "id": {"type": "string"},
          "member_node_ids": {"type": "array", "items": {"type": "string"}},
          "prototype_vowels": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "sound_score", "label", "rhyme_types"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "sound_score": {"type": "number", "minimum": 0, "maximum": 1},
          "label": {"type": "string"},
          "rhyme_types": {"type": "array", "items": {"type": "string"}},
          "domain_morae": {"type": "integer", "minimum": 0},
          "semantic_fit": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "transition_cost": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
